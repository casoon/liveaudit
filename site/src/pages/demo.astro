---
import { Callout, Demo } from "@casoon/pages-theme/components";
import Base from "@casoon/pages-theme/layouts/Base.astro";
import { url } from "@casoon/pages-theme/url";

const pixel = "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";

// An invented role and a reference into nothing. `knob` is not a role — that is
// the exhibit; the cast is what it costs to write a defect down in a checked
// template.
const invented = {
  role: "knob",
  "aria-labelledby": "not-here",
} as unknown as astroHTML.JSX.HTMLAttributes;
---

<Base
  title="Demo"
  description="The inspector layer running on this page: one button, and every finding appears on the element it belongs to."
>
  <section class="intro">
    <h1>Press the button. The findings stay on the page.</h1>
    <p>
      This is LiveAudit inspecting the page you are reading — not a recording of it. The
      fragment below carries defects on purpose; the rest of the page is this site, unchanged
      and included in the scan.
    </p>
    <p class="quiet">
      Nothing runs until you say so, and nothing is repaired afterwards. The inspector reads
      the DOM and draws its own layer beside it; the fragment keeps every attribute it has
      now, including the broken ones.
    </p>
  </section>

  <div class="stagewrap">
    <Demo
      title="The page under inspection"
      lead="A fragment with known defects, rendered on its own white surface so the contrast cases hold in both themes."
      label="Fragment with deliberate accessibility defects"
    >
      <div slot="controls" class="controls">
        <!-- Enabled by the demo script: without JavaScript these would do nothing. -->
        <button type="button" id="demo-show" disabled>Show the inspector</button>
        <button type="button" id="demo-hide" disabled>Hide it again</button>
        <span class="check">
          <input type="checkbox" id="demo-contrast" disabled />
          <label for="demo-contrast">Include contrast (second pass)</label>
        </span>
        <p class="status" id="demo-status" role="status">
          JavaScript is off, so the inspector cannot run. Everything else on this page works
          without it.
        </p>
      </div>

      <div class="probe">
        <h3>Reservations</h3>

        <!-- images/alt-missing, images/alt-suspicious -->
        <img src={pixel} width="120" height="80" />
        <img src={pixel} alt="photo.jpg" width="32" height="32" />

        <!-- forms/label-missing, zweimal: ein Platzhalter ist keine Beschriftung -->
        <p><input type="text" id="twice" /></p>
        <p><input type="email" placeholder="Email address" /></p>

        <!-- ids/duplicate -->
        <p id="twice">The same id, a second time.</p>

        <!-- links/name-missing, links/generic-name -->
        <p><a href="#demo-status"></a> <a href="#demo-status">here</a></p>

        <!-- buttons/name-missing, keyboard/positive-tabindex -->
        <p><button type="button" tabindex="3"></button></p>

        <!-- aria/role-invalid, aria/reference-missing -->
        <p {...invented}>An element with an invented role.</p>

        <!-- headings/skip-level, headings/empty -->
        <h5>A heading that skips a level</h5>
        <h6></h6>

        <!-- svg/name-missing -->
        <svg width="40" height="40" viewBox="0 0 40 40">
          <circle cx="20" cy="20" r="18" fill="#a1a1aa"></circle>
        </svg>

        <!-- tables/header-missing, tables/name-missing -->
        <table>
          <tr><td>Monday</td><td>9:00</td></tr>
          <tr><td>Tuesday</td><td>11:00</td></tr>
        </table>

        <!-- lists/invalid-structure, lists/empty -->
        <ul><div>Not a list item.</div></ul>

        <!-- contrast/text-insufficient: 2.85:1 on white -->
        <p class="faint">Grey on white, 2.85:1 — this has to be caught.</p>

        <!-- contrast/text-undetermined: no single background colour to measure against -->
        <p class="onGradient">White on a gradient — not decidable, so UNTESTED.</p>
      </div>

      <!-- is:inline keeps the script here instead of hoisting it into the head:
           a demo's own scripts belong inside the stage. -->
      <script is:inline type="module" src={url('demo/start.js')}></script>
    </Demo>
  </div>

  <div class="after">
    <Callout type="note" title="What the four states mean here">
      <p>
        <strong>FAIL</strong> was proven — the image has no alt text, the id exists twice.
        <strong>REVIEW</strong> is a suspicion a person has to settle: "here" may well be a
        fine link name in its sentence. <strong>UNTESTED</strong> is the one that separates
        this from a score: text on a gradient has no single background colour to measure, so
        the rule says so instead of guessing white and passing it.
      </p>
      <p>
        Turn the contrast pass off and the two contrast rules report UNTESTED rather than
        silence — the report states what it did not inspect.
      </p>
    </Callout>

    <Callout type="caution" title="It inspects. It does not repair.">
      <p>
        No attribute, style or node inside the fragment changes while the layer is up: the
        inspector keeps its own host element as the last child of <code>&lt;body&gt;</code>,
        fixed and click-through, and every marker is positioned from measurements it read.
        Hide it and nothing of it remains. That is the whole difference to an accessibility
        overlay, which edits the page and leaves the defects in the source.
      </p>
    </Callout>
  </div>
</Base>

<style>
  .intro,
  .stagewrap,
  .after {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px;
  }
  .intro {
    padding-top: 64px;
    padding-bottom: 32px;
    max-width: min(var(--max), 760px);
  }
  h1 {
    margin: 0 0 16px;
    color: var(--heading);
    font-size: clamp(28px, 4vw, 40px);
    letter-spacing: -0.02em;
  }
  .intro p {
    margin: 0 0 12px;
    font-size: 16.5px;
  }
  .quiet {
    color: var(--muted);
    font-size: 15px;
  }
  .after {
    max-width: min(var(--max), 760px);
    padding-bottom: 72px;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
  }
  .controls button {
    padding: 8px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 9px;
    background: var(--surface);
    color: var(--heading);
    font: inherit;
    font-size: 14.5px;
    cursor: pointer;
  }
  .controls button:hover:not(:disabled) {
    border-color: var(--accent);
  }
  .controls button:disabled {
    color: var(--muted);
    cursor: not-allowed;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 14.5px;
  }
  .status {
    flex-basis: 100%;
    margin: 0;
    color: var(--muted);
    font-size: 13.5px;
  }

  /* The fragment is a small page of its own: fixed light surface, so the two
     contrast cases mean the same thing in the light and the dark theme. */
  .probe {
    padding: 20px;
    border: 1px solid #d4d4d8;
    border-radius: 10px;
    background: #ffffff;
    color: #18181b;
    font-size: 15px;
  }
  /* Das 1x1-Pixel ist durchsichtig: ohne Fläche stünde hier nur Leerraum, wo die
     Demo ein Bild meint. */
  .probe img {
    background: #e4e4e7;
    border: 1px solid #d4d4d8;
  }
  .probe h3 {
    margin: 0 0 12px;
    color: #18181b;
    font-size: 15px;
  }
  .probe h5,
  .probe h6 {
    margin: 14px 0 6px;
    color: #18181b;
  }
  .probe p {
    margin: 10px 0;
  }
  .probe a {
    color: #1d4ed8;
  }
  .probe input {
    padding: 6px 8px;
    border: 1px solid #a1a1aa;
    border-radius: 6px;
    background: #ffffff;
    color: #18181b;
    font: inherit;
  }
  .probe button {
    min-width: 2rem;
    min-height: 2rem;
    border: 1px solid #a1a1aa;
    border-radius: 6px;
    background: #f4f4f5;
    font: inherit;
  }
  .probe td {
    padding: 4px 12px 4px 0;
  }
  .probe .faint {
    color: #999999;
  }
  .probe .onGradient {
    padding: 6px 10px;
    background-image: linear-gradient(90deg, #333333, #cccccc);
    color: #ffffff;
  }
</style>
