---
import {
  Badge,
  Badges,
  Button,
  Callout,
  CodeBlock,
  Facts,
  Features,
  Hero,
  Install,
  Quickstart,
} from "@casoon/pages-theme/components";
import Base from "@casoon/pages-theme/layouts/Base.astro";
import { url } from "@casoon/pages-theme/url";
// Real capture of the demo page (site/src/pages/demo.astro) at 1000 × 680, after
// "Show the inspector" with the contrast pass: 42 findings over 209 nodes. The narrow
// file is the left part of the same capture, for phones. Retake both when the layer's
// look changes.
import inspectorShot from "../assets/inspector-demo.webp?url";
import inspectorNarrow from "../assets/inspector-demo-narrow.webp?url";

const embed = `<!-- your own copy, on your own domain -->
<script
  type="module"
  src="/vendor/liveaudit/inspector.js"
></script>`;
---

<Base>
  <Hero
    title="Accessibility inspection where the page actually runs."
    lead="One script tag on your own site, and findings appear on the affected element — in the page's real state, after every script, embed and client-side render has had its say."
  >
    <Install commands={[{ label: 'npm', command: 'npm install @casoon/liveaudit' }]} />
    <div class="cta">
      <Button href={url('demo/')}>See it inspect</Button>
      <Button href={url('docs/')} variant="secondary">Documentation</Button>
    </div>
    <Badges>
      <Badge>MIT</Badge>
      <Badge>self-hosted</Badge>
      <Badge>Rust → WebAssembly</Badge>
      <Badge>no runtime framework</Badge>
    </Badges>
    <figure slot="output" class="shot">
      <picture>
        <source media="(max-width: 640px)" srcset={inspectorNarrow} width="800" height="907" />
        <img
          src={inspectorShot}
          width="1400"
          height="952"
          alt="Screenshot of the LiveAudit demo page with the inspector layer open, 42 findings. Numbered markers sit on the defective elements of a reservation form: an image without alt text, two inputs without labels, a duplicated id, a heading that skips a level, a table without headers. The dark sidebar counts 16 FAIL, 4 REVIEW, 22 UNTESTED and 0 PASS over 209 scanned nodes and 56 rules."
        />
      </picture>
      <figcaption>The <a class="inline" href={url('demo/')}>demo page</a> with the inspector layer open: markers on the elements, the sidebar with the four states.</figcaption>
    </figure>
  </Hero>

  <Facts
    items={[
      { value: '18.8 kB', label: 'gzipped JavaScript, layer included' },
      { value: '80.9 kB', label: 'gzipped WebAssembly, the whole rule set' },
      { value: '4', label: 'states a finding can have — never a score' },
      { value: '0', label: 'attributes written to the inspected page' },
    ]}
  />

  <Features
    heading="What makes it different"
    items={[
      {
        title: 'Findings on the element, not beside it',
        body: 'A report tells you that an image on some page has no alt text. The inspector layer puts the finding on that image, in the state the page is actually in — after hydration, after the third-party embed loaded, after the cookie banner appeared.',
      },
      {
        title: 'Two axes, never a percentage',
        body: 'Outcome says how certain the statement is: FAIL proven, REVIEW suspected, PASS passed, UNTESTED not decidable by machine. Severity says how much it weighs. A single number would hide exactly that difference, so there is none.',
      },
      {
        title: '"Not testable" is not "passed"',
        body: 'A contrast rule without rendering access reads like a passed check in most tools. Here it is listed as not run, with the reason. Where it runs but cannot decide — text on a gradient has no single background colour to measure — it reports UNTESTED instead of a verdict.',
      },
      {
        title: 'It inspects. It does not repair.',
        body: 'No data attributes, no inline styles, no rewritten markup: the layer lives in its own host element and positions itself from measurements it reads. This is deliberately not an accessibility overlay: it makes no claim to repair anything.',
      },
      {
        title: 'One rule set, three surfaces',
        body: 'The rules live in the shared Rust core in barrierlab, which also drives astro-post-audit at build time and auditmysite in CI. A finding carries the same rule id in all three. That reuse — not speed — is why the core is Rust.',
      },
    ]}
  />

  <Quickstart
    lead="LiveAudit is self-hosted: you install it, copy two files into your own project and serve them from your own domain. A centrally hosted script would make someone else's domain a permanent dependency of your site."
    steps={[
      'Install it: <code>npm install @casoon/liveaudit</code> — the package holds <code>inspector.js</code> and <code>a11y_wasm_bg.wasm</code>, built and ready.',
      'Copy both files next to each other into your own site and add the script tag. The module loads its WebAssembly from beside itself.',
      'Open the page with <code>?liveaudit</code>. Without the flag the script registers nothing, creates no global and loads no WebAssembly.',
      'Call <code>LiveAudit.show()</code> from the console or from your own toolbar.',
    ]}
  >
    <CodeBlock code={embed} lang="html" title="index.html" label="html" />
  </Quickstart>

  <div class="notes">
    <Callout type="note" title="On npm, still self-hosted">
      <p>
        <code>@casoon/liveaudit</code> carries the two built files, not the sources. Copy them
        from <code>node_modules</code> into your public directory at build time; updating is an
        ordinary dependency update, and nothing is loaded from anyone else's domain.
      </p>
    </Callout>

    <Callout type="caution" title="If your site has a strict Content Security Policy">
      <p>
        Instantiating WebAssembly needs <code>wasm-unsafe-eval</code> in
        <code>script-src</code>. Without it the inspector fails with an error that names the
        missing directive instead of failing silently.
      </p>
    </Callout>
  </div>
</Base>

<style>
  .shot {
    margin: 0;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .shot .inline {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .shot figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 13.5px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .notes {
    max-width: min(var(--max), 760px);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
</style>
